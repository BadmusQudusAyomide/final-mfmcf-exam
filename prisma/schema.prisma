generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Candidate {
  id           String           @id @default(cuid())
  fullName     String
  matricNumber String
  phoneNumber  String
  department   String
  level        String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     ExamSession[]
  submissions  ExamSubmission[]
}

model Exam {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  instructions    String?
  durationMinutes Int
  status          ExamStatus       @default(DRAFT)
  departments     String[]
  levels          String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       ExamQuestion[]
  sessions        ExamSession[]
  submissions     ExamSubmission[]
}

model ExamQuestion {
  id          String         @id @default(cuid())
  examId      String
  prompt      String
  explanation String?
  order       Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  options     QuestionOption[]

  @@unique([examId, order])
}

model QuestionOption {
  id         String       @id @default(cuid())
  questionId String
  label      String
  order      Int
  isCorrect  Boolean      @default(false)
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
}

model ExamSession {
  id           String         @id @default(cuid())
  examId        String
  candidateId   String
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  completedAt   DateTime?
  status        SessionStatus @default(ACTIVE)
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([examId, candidateId])
}

model ExamSubmission {
  id               String            @id @default(cuid())
  examId           String
  candidateId      String
  score            Int
  totalQuestions   Int
  submittedAt      DateTime          @default(now())
  securityFlags    Int               @default(0)
  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submittedAnswers SubmittedAnswer[]

  @@unique([examId, candidateId])
}

model SubmittedAnswer {
  id             String         @id @default(cuid())
  submissionId   String
  questionId     String
  questionOrder  Int
  prompt         String
  explanation    String?
  correctAnswer  String
  selectedOption String?
  isCorrect      Boolean
  submission     ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SessionStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
  VOIDED
}
